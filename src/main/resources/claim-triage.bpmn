<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_ClaimTriage"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.10.0">

  <bpmn:error id="Error_ExtractionFailed" name="Extraction failed" errorCode="EXTRACTION_FAILED" />

  <bpmn:process id="claim-triage" name="Claim triage" isExecutable="true">

    <bpmn:startEvent id="ClaimReceived" name="Claim received">
      <bpmn:outgoing>Flow_ToExtract</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- The LLM step. A Java job worker (ExtractClaimWorker) picks up jobs of type "extract-claim". -->
    <bpmn:serviceTask id="ExtractClaim" name="Extract claim details (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="extract-claim" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToExtract</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Business error from the worker: the extraction is unusable, so a person takes over.
         Variables sent with a BPMN error are local to this catch event; the outputs lift them to the process. -->
    <bpmn:boundaryEvent id="ExtractionFailed" name="Extraction unusable" attachedToRef="ExtractClaim">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=extractionProblems" target="extractionProblems" />
          <zeebe:output source="=extractedBy" target="extractedBy" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToTriage</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ExtractionFailed" />
    </bpmn:boundaryEvent>

    <bpmn:userTask id="ManualTriage" name="Triage claim manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manual-triage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTriage</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHandledManually</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="HandledManually" name="Handled manually">
      <bpmn:incoming>Flow_ToHandledManually</bpmn:incoming>
    </bpmn:endEvent>

    <!-- The human gate. Nothing downstream runs until a person decides. -->
    <bpmn:userTask id="ReviewClaim" name="Review claim">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-claim" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Approved" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="QueuePayout" name="Queue payout">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="queue-payout" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPayoutQueued</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="PayoutQueued" name="Payout queued">
      <bpmn:incoming>Flow_ToPayoutQueued</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="SendRejection" name="Send rejection notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToClaimRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="ClaimRejected" name="Claim rejected">
      <bpmn:incoming>Flow_ToClaimRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToExtract" sourceRef="ClaimReceived" targetRef="ExtractClaim" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="ExtractClaim" targetRef="ReviewClaim" />
    <bpmn:sequenceFlow id="Flow_ToTriage" sourceRef="ExtractionFailed" targetRef="ManualTriage" />
    <bpmn:sequenceFlow id="Flow_ToHandledManually" sourceRef="ManualTriage" targetRef="HandledManually" />
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="ReviewClaim" targetRef="Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="yes" sourceRef="Approved" targetRef="QueuePayout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="no" sourceRef="Approved" targetRef="SendRejection" />
    <bpmn:sequenceFlow id="Flow_ToPayoutQueued" sourceRef="QueuePayout" targetRef="PayoutQueued" />
    <bpmn:sequenceFlow id="Flow_ToClaimRejected" sourceRef="SendRejection" targetRef="ClaimRejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_ClaimTriage">
    <bpmndi:BPMNPlane id="Plane_ClaimTriage" bpmnElement="claim-triage">
      <bpmndi:BPMNShape id="ClaimReceived_di" bpmnElement="ClaimReceived">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="133" y="225" width="74" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExtractClaim_di" bpmnElement="ExtractClaim">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExtractionFailed_di" bpmnElement="ExtractionFailed">
        <dc:Bounds x="272" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="306" y="265" width="58" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManualTriage_di" bpmnElement="ManualTriage">
        <dc:Bounds x="240" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandledManually_di" bpmnElement="HandledManually">
        <dc:Bounds x="402" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="377" y="385" width="86" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewClaim_di" bpmnElement="ReviewClaim">
        <dc:Bounds x="400" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approved_di" bpmnElement="Approved" isMarkerVisible="true">
        <dc:Bounds x="555" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="553" y="151" width="54" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="QueuePayout_di" bpmnElement="QueuePayout">
        <dc:Bounds x="660" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PayoutQueued_di" bpmnElement="PayoutQueued">
        <dc:Bounds x="822" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="804" y="225" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendRejection_di" bpmnElement="SendRejection">
        <dc:Bounds x="660" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClaimRejected_di" bpmnElement="ClaimRejected">
        <dc:Bounds x="822" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="805" y="355" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToExtract_di" bpmnElement="Flow_ToExtract">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReview_di" bpmnElement="Flow_ToReview">
        <di:waypoint x="340" y="200" /><di:waypoint x="400" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTriage_di" bpmnElement="Flow_ToTriage">
        <di:waypoint x="290" y="258" /><di:waypoint x="290" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHandledManually_di" bpmnElement="Flow_ToHandledManually">
        <di:waypoint x="340" y="360" /><di:waypoint x="402" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecision_di" bpmnElement="Flow_ToDecision">
        <di:waypoint x="500" y="200" /><di:waypoint x="555" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="605" y="200" /><di:waypoint x="660" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="624" y="182" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="580" y="225" /><di:waypoint x="580" y="330" /><di:waypoint x="660" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="588" y="270" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPayoutQueued_di" bpmnElement="Flow_ToPayoutQueued">
        <di:waypoint x="760" y="200" /><di:waypoint x="822" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToClaimRejected_di" bpmnElement="Flow_ToClaimRejected">
        <di:waypoint x="760" y="330" /><di:waypoint x="822" y="330" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
